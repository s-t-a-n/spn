{
  "version": 1,
  "config": {
    "cppcheck": {
      "binary": "cppcheck",
      "std": "c++20",
      "check_level": "exhaustive",
      "libraries": [
        "std",
        "posix",
        "gnu",
        "zephyr"
      ],
      "suppressions": [
        "*:*/build/*",
        "*:*/.cache/*",
        "*:*/external/*",
        "*:*/third_party/*",
        "*:*/vendor/*",
        "*:*/out/*"
      ],
      "dump_flags": [
        "--enable=all",
        "--inconclusive",
        "--force",
        "--inline-suppr",
        "--platform=unix32"
      ]
    },
    "misra_addon": {
      "enabled": true,
      "script": "/usr/lib/x86_64-linux-gnu/cppcheck/addons/misra.py",
      "suppress_rules": [],
      "extra_args": [
        "--severity",
        "error"
      ]
    },
    "threadsafety_addon": {
      "enabled": true,
      "script": "/usr/lib/x86_64-linux-gnu/cppcheck/addons/threadsafety.py",
      "suppress_rules": [],
      "extra_args": []
    },
    "y2038_addon": {
      "enabled": true,
      "script": "/usr/lib/x86_64-linux-gnu/cppcheck/addons/y2038.py",
      "suppress_rules": [],
      "extra_args": []
    }
  }
}
